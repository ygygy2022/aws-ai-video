{
	"singleQuote": true,
	"tabWidth": 2,
	"useTabs": false,
	"printWidth": 80,
	"semi": true,
	"trailingComma": "es5",
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"bracketSameLine": false,
	"jsxSingleQuote": false,
	"proseWrap": "preserve",
	"quoteProps": "as-needed",
	"requirePragma": false,
	"insertPragma": false,
	"htmlWhitespaceSensitivity": "css"
}
